{
  "name": "wolfdrive",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "epubjs": "^0.3.93",
    "hono": "^4.13.5",
    "lucide-vue-next": "^1.0.0",
    "md-editor-v3": "^6.5.6",
    "vue": "^3.5.42",
    "vue-router": "4"
  },
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web",
    "dev:api": "bun --hot src/index.ts",
    "dev:web": "bun node_modules/vite/bin/vite.js --host",
    "build": "bun node_modules/vite/bin/vite.js build && tsc",
    "preview": "bun node_modules/vite/bin/vite.js preview",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate --dialect sqlite --schema ./src/db/schema.ts --out ./drizzle",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "db:scan": "bun run src/scripts/scan.ts"
  }
}
